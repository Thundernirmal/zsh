# Autoloaded implementation for the session-only theme command.

_ztheme_usage() {
  print 'Usage: ztheme <command> [theme]'
  print
  print 'Commands:'
  print '  list             List built-in themes'
  print '  current          Show the active session settings'
  print '  show [theme]     Show semantic role values'
  print '  use <theme>      Apply a theme to this shell session'
  print '  reset            Restore defaults and clear any fzf override'
  print '  export <theme>   Print safe settings for ~/.zshrc'
}

_ztheme_validate_name() {
  emulate -L zsh
  local name=$1
  if _zsh_theme_is_builtin "$name"; then
    return 0
  fi
  [[ $name == custom ]] && _zsh_theme_capture_custom
}

_ztheme_refresh_integrations() {
  emulate -L zsh
  if [[ ${_FZF_STATE:-blocked} == ready ]] && (( $+functions[_fzf_export_config] )); then
    _fzf_export_config
  elif (( $+functions[_zsh_zoxide_refresh_fzf_opts] )); then
    _zsh_zoxide_refresh_fzf_opts
  fi
}

_ztheme_apply() {
  emulate -L zsh
  local name=$1 mode=${2:-use} old_ui=${ZSH_UI_THEME:-terminal} old_fzf=${ZSH_FZF_THEME-}

  _ztheme_validate_name "$name" || {
    print -u2 -r -- "ztheme: unknown or invalid theme: $name"
    return 1
  }

  typeset -g ZSH_UI_THEME=$name
  [[ $mode == reset ]] && typeset -g ZSH_FZF_THEME=''
  _zsh_theme_resolve_settings
  if ! _ztheme_refresh_integrations; then
    typeset -g ZSH_UI_THEME=$old_ui
    typeset -g ZSH_FZF_THEME=$old_fzf
    _zsh_theme_resolve_settings
    _ztheme_refresh_integrations >/dev/null 2>&1 || true
    print -u2 -r -- 'ztheme: could not refresh finder presentation; theme unchanged'
    return 1
  fi
  print -r -- "Theme: $name (current session)"
}

_ztheme_role_value() {
  emulate -L zsh
  local theme=$1 role=$2
  integer code

  if [[ $theme == terminal ]]; then
    _zsh_theme_terminal_code "$role" || return 1
    code=$REPLY
    (( code < 0 )) && REPLY=default || REPLY="ansi:$code"
    return 0
  fi
  _zsh_theme_role_hex "$theme" "$role" || return 1
  REPLY="#$REPLY"
}

_ztheme_role_sgr() {
  emulate -L zsh
  local theme=$1 role=$2 layer=${3:-bg} depth

  _zsh_theme_detect_color_depth
  depth=$REPLY
  _zsh_theme_load_color_helpers || return 1
  _zsh_theme_sgr_for_theme "$theme" "$role" "$layer" "$depth"
}

_ztheme_list() {
  emulate -L zsh
  local name annotations
  print 'Theme'
  for name in "${_ZSH_UI_THEME_NAMES[@]}"; do
    annotations=''
    [[ $name == ${_ZSH_UI_ACTIVE_THEME:-} ]] && annotations+='ui '
    [[ $name == ${_ZSH_FZF_ACTIVE_THEME:-} ]] && annotations+='fzf '
    [[ $name == terminal ]] && annotations+='default '
    annotations=${annotations% }
    print -r -- "${name}${annotations:+ [$annotations]}"
  done
  if [[ ${_ZSH_UI_ACTIVE_THEME:-} == custom || ${_ZSH_FZF_ACTIVE_THEME:-} == custom ]]; then
    annotations=''
    [[ ${_ZSH_UI_ACTIVE_THEME:-} == custom ]] && annotations+='ui '
    [[ ${_ZSH_FZF_ACTIVE_THEME:-} == custom ]] && annotations+='fzf '
    print -r -- "custom [${annotations% }]"
  fi
}

_ztheme_current() {
  emulate -L zsh
  local external=no fzf_note='' depth glyph sample=''
  if [[ -n ${_FZF_INHERITED_DEFAULT_OPTS:-}${_FZF_INHERITED_CTRL_T_OPTS:-}${_FZF_INHERITED_CTRL_R_OPTS:-}${_FZF_INHERITED_ALT_C_OPTS:-}${_FZF_INHERITED_COMPLETION_OPTS:-}${_FZF_INHERITED_COMPLETION_PATH_OPTS:-}${_FZF_INHERITED_COMPLETION_DIR_OPTS:-}${_ZSH_ZOXIDE_INHERITED_FZF_OPTS:-}${ZSH_FZF_EXTRA_OPTS:-} ]]; then
    external=yes
  fi
  [[ -z ${ZSH_FZF_THEME-} ]] && fzf_note=' (inherits UI)'
  _zsh_theme_detect_color_depth
  depth=$REPLY
  if _zsh_theme_resolve_glyph_tier "${ZSH_UI_GLYPHS:-auto}"; then
    glyph=$REPLY
  else
    glyph=${_ZSH_UI_GLYPH_TIER:-ascii}
  fi
  if (( $+functions[_zsh_theme_glyph] )); then
    local pointer_sample='' marker_sample='' gutter_sample=''
    _zsh_theme_glyph pointer "$glyph" && pointer_sample=$REPLY
    _zsh_theme_glyph marker "$glyph" && marker_sample=$REPLY
    _zsh_theme_glyph gutter "$glyph" && gutter_sample=$REPLY
    [[ -n $pointer_sample$marker_sample$gutter_sample ]] && sample=" [$pointer_sample $marker_sample $gutter_sample]"
  fi
  print -r -- "UI theme: ${_ZSH_UI_ACTIVE_THEME:-terminal}"
  print -r -- "fzf theme: ${_ZSH_FZF_ACTIVE_THEME:-${_ZSH_UI_ACTIVE_THEME:-terminal}}${fzf_note}"
  print -r -- "fzf layout: ${ZSH_FZF_LAYOUT:-compact}"
  print -r -- "glyphs: $glyph (requested: ${ZSH_UI_GLYPHS:-auto})$sample"
  print -r -- "color depth: $depth"
  print -r -- "external fzf options: $external"
}

_ztheme_show() {
  emulate -L zsh
  local theme=$1 role value swatch='' reset=''
  integer rich=0
  (( $+functions[_ui_is_rich_terminal] )) && _ui_is_rich_terminal && rich=1

  print -r -- "Theme: $theme"
  print 'Role        Value'
  for role in "${_ZSH_UI_THEME_ROLES[@]}"; do
    _ztheme_role_value "$theme" "$role" || return 1
    value=$REPLY
    swatch=''
    reset=''
    if (( rich )) && _ztheme_role_sgr "$theme" "$role" bg; then
      swatch="${REPLY}  "
      reset=$'\e[0m'
    fi
    printf '%s%s%-11s %s\n' "$swatch" "$reset" "$role" "$value"
  done
}

_ztheme_export() {
  emulate -L zsh
  local theme=$1 role
  if [[ $theme == custom ]]; then
    print 'typeset -gA ZSH_UI_CUSTOM_COLORS=('
    for role in "${_ZSH_UI_THEME_ROLES[@]}"; do
      print -r -- "  $role ${_ZSH_THEME_CUSTOM_COLORS[$role]}"
    done
    print ')'
  fi
  print -r -- "typeset -g ZSH_UI_THEME=${(q)theme}"
  print "typeset -g ZSH_FZF_THEME=''"
}

ztheme() {
  emulate -L zsh
  local command=${1-} theme
  case $command in
    list)
      (( $# == 1 )) || { _ztheme_usage >&2; return 1; }
      _ztheme_list
      ;;
    current)
      (( $# == 1 )) || { _ztheme_usage >&2; return 1; }
      _ztheme_current
      ;;
    show)
      (( $# <= 2 )) || { _ztheme_usage >&2; return 1; }
      theme=${2:-${_ZSH_UI_ACTIVE_THEME:-terminal}}
      _ztheme_validate_name "$theme" || { print -u2 -r -- "ztheme: unknown or invalid theme: $theme"; return 1; }
      _ztheme_show "$theme"
      ;;
    use)
      (( $# == 2 )) || { _ztheme_usage >&2; return 1; }
      _ztheme_apply "$2"
      ;;
    reset)
      (( $# == 1 )) || { _ztheme_usage >&2; return 1; }
      _ztheme_apply terminal reset
      ;;
    export)
      (( $# == 2 )) || { _ztheme_usage >&2; return 1; }
      _ztheme_validate_name "$2" || { print -u2 -r -- "ztheme: unknown or invalid theme: $2"; return 1; }
      _ztheme_export "$2"
      ;;
    -h|--help|help)
      _ztheme_usage
      ;;
    *)
      [[ -n $command ]] && print -u2 -r -- "ztheme: unknown command: $command"
      _ztheme_usage >&2
      return 1
      ;;
  esac
}

ztheme "$@"
